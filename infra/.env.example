# Copy to infra/.env to override the local defaults in compose.yaml. Local and test values only.
POSTGRES_USER=claimlens_owner
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=claimlens
APP_DB_PASSWORD=local-app-only
AUTH_SIGNING_KEY=local-development-signing-key-not-for-any-real-use
SEED_DEV_PASSWORD=local-dev-password
DOCUMENT_AI_SERVICE_KEY=local-service-key
