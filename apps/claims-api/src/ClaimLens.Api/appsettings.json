{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "claimlens-claims-api",
    "Audience": "claimlens-staff-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8,
    "RotationGraceSeconds": 10,
    "SignInFailuresPerEmail": 5,
    "SignInFailuresPerAddress": 20,
    "SignInWindowMinutes": 15
  },
  "Release": {
    "IncludeShould": false
  },
  "Storage": {
    "Bucket": "claimlens",
    "Region": "us-east-1",
    "CreateBucket": false,
    "TimeoutSeconds": 30
  },
  "Converter": {
    "TimeoutSeconds": 90
  },
  "Limits": {
    "MaxFileBytes": 20971520,
    "MaxPagesPerClaim": 30
  },
  "Workers": {
    "DocumentPreparation": {
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "ConcurrentRuns": 1
    },
    "AiJobs": {
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "ConcurrentRuns": 2,
      "MaxAttempts": 5,
      "RetryDelaySeconds": 10
    }
  },
  "Ai": {
    "PageCheck": { "Name": "page-classifier", "Version": "v2.4", "TimeoutSeconds": 30 },
    "FieldExtraction": { "Name": "field-extractor", "Version": "v2.4", "TimeoutSeconds": 120 },
    "PageReread": { "Name": "field-extractor", "Version": "v2.4", "TimeoutSeconds": 60 }
  },
  "Thresholds": {
    "PageType": 0.80,
    "GeneralField": 0.90,
    "MoneyAndIdentityField": 0.95,
    "NeedsEntryBelow": 0.70,
    "PageQuality": 0.50,
    "BenefitMapping": 0.85
  },
  "Queue": {
    "HighValueThreshold": 5000000
  }
}
