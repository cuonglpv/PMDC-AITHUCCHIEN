{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8,
    "RotationGraceSeconds": 10,
    "SignInFailuresPerEmail": 5,
    "SignInFailuresPerAddress": 20,
    "SignInWindowMinutes": 15
  },
  "Release": {
    "IncludeShould": false
  }
}
