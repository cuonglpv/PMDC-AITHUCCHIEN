@startuml use-case
' Strict UML use case diagram — render with PlantUML (VS Code extension or plantuml.jar)
' Must stay consistent with the Mermaid diagram in docs/03-use-cases.md
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #1A56DB
  BackgroundColor<<AI>> #F5F3FF
  BorderColor<<AI>> #7C3AED
  BackgroundColor<<System>> #F0FDFA
  BorderColor<<System>> #0F766E
}

' Primary actors (left)
actor "Staff" as Staff <<abstract>>
actor "Intake Officer" as Intake
actor "Claims Reviewer" as Reviewer
actor "Senior Approver" as Approver
actor "Administrator" as Admin

Intake --|> Staff
Reviewer --|> Staff
Approver --|> Staff
Admin --|> Staff

rectangle "ClaimLens" {
  usecase "UC01 Sign in to role workspace" as UC01
  usecase "UC02 Submit claim packet" as UC02
  usecase UC03 as "UC03 Verify extracted evidence
--
extension points
Page re-read"
  usecase "UC04 Resolve validation alerts" as UC04
  usecase "UC05 Review benefit adjudication" as UC05
  usecase "UC06 Review risk flags" as UC06
  usecase "UC07 Submit recommendation" as UC07
  usecase "UC08 Approve, reject or return claim" as UC08
  usecase UC09 as "UC09 Publish benefit rule-set version
--
extension points
Test draft"
  usecase "UC10 Monitor AI quality" as UC10
  usecase "UC11 Trace claim decision history" as UC11

  usecase "AI-01 Classify & extract documents" as AI01 <<AI>>
  usecase "AI-02 Map expense lines to benefits" as AI02 <<AI>>
  usecase "AI-03 Detect clinical inconsistencies" as AI03 <<AI>>
  usecase "AI-04 Draft evidence-backed summary" as AI04 <<AI>>

  usecase "SYS-01 Evaluate policy rules" as SYS01 <<System>>
}

' Secondary actor (right)
actor "AI Document\nIntelligence Service" as AISvc <<system>>

Staff -- UC01
Intake -- UC02
Reviewer -- UC03
Reviewer -- UC04
Reviewer -- UC05
Reviewer -- UC06
Reviewer -- UC07
Reviewer -- UC11
Approver -- UC08
Approver -- UC10
Approver -- UC11
Admin -- UC09

UC02 ..> AI01 : <<include>>
AI01 ..> UC03 : <<extend>>\n[page misread]
UC04 ..> AI03 : <<include>>
UC05 ..> AI02 : <<include>>
UC05 ..> SYS01 : <<include>>
UC07 ..> AI04 : <<include>>
SYS01 ..> UC09 : <<extend>>\n[test run requested]

AI01 -- AISvc
AI02 -- AISvc
AI03 -- AISvc
AI04 -- AISvc

note right of AI01
  AI outputs are suggestions with
  confidence + source region.
  Below threshold → empty or
  "Needs verification" (UC03).
end note

note bottom of UC08
  Maker–checker: the submitter of
  UC07 cannot perform UC08 (BR-06).
end note

note bottom of UC11
  Reviewer: own claims only.
  Administrator: no claim content.
end note
@enduml
